{
  "name": "budget-month",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @budget-month/web",
    "build:web": "npm run build --workspace @budget-month/web",
    "start:web": "npm run start --workspace @budget-month/web",
    "dev:mobile": "npm run start --workspace @budget-month/mobile",
    "android": "npm run android --workspace @budget-month/mobile",
    "ios": "npm run ios --workspace @budget-month/mobile",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2"
  }
}
